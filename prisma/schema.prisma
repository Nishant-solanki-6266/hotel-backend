model WaThread {
  id         String      @id
  contact    String
  role       String
  phone      String
  department String
  messages   WaMessage[]
}

model WaMessage {
  id       String   @id
  threadId String
  from     String
  body     String   @db.Text
  at       String
  buttons  String   @default("[]")
  chosen   String?
  thread   WaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId], map: "WaMessage_threadId_fkey")
}

model KnowledgeChunk {
  id                String       @id @default(uuid())
  knowledgeDocId    String       @map("docId")
  hotelId           String       // redundancy for tenant isolation
  chunkIndex        Int
  content           String       @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  knowledgeDoc      KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@index([knowledgeDocId])
  @@index([hotelId])
}
