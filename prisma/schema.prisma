generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id              String   @id @default("hotel-mercier")
  name            String
  legalName       String
  stars           Int      @default(4)
  roomsCount      Int      @default(48)
  address         String
  postcode        String
  city            String
  country         String
  timezone        String   @default("Europe/Brussels")
  currency        String   @default("€")
  phone           String
  email           String
  website         String
  bookingEngine   String
  whatsappNumber  String
  checkIn         String   @default("15:00")
  checkOut        String   @default("11:00")
  vatNumber       String
  description     String   @db.Text
  waTopology      String   @default("separate")
  onboardingDone  Boolean  @default(false)
  onboardingSteps String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  hotelId      String?  @default("hotel-mercier")
  name         String
  email        String   @unique
  passwordHash String
  role         String
  title        String
  phone        String
  initials     String
  lastActive   String   @default("now")
  whatsapp     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Room {
  number       String  @id
  mewsId       String?
  hotelId      String? @default("hotel-mercier")
  floor        Int
  status       String  @default("Clean")
  cleaningType String  @default("Departure")
  guestStatus  String  @default("Vacant")
  arrivalTime  String?
  priority     String  @default("Normal")
  cleaner      String?
  vip          Boolean @default(false)
  note         String? @db.Text
  updatedAt    String

  @@index([hotelId, status])
  @@index([hotelId, mewsId])
}

model Guest {
  id            String         @id
  mewsId        String?
  hotelId       String?        @default("hotel-mercier")
  name          String
  room          String?
  country       String
  language      String
  vip           Boolean        @default(false)
  previousStays Int            @default(0)
  tags          String         @default("[]")
  reservations  Reservation[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([hotelId, name])
  @@index([hotelId, mewsId])
}

model Reservation {
  number    String   @id
  mewsId    String?
  hotelId   String?  @default("hotel-mercier")
  guestId   String
  arrival   String
  departure String
  nights    Int
  adults    Int
  children  Int      @default(0)
  roomType  String
  status    String   @default("Confirmed")
  rate      String
  createdAt DateTime @default(now())
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId], map: "Reservation_guestId_fkey")
  @@index([hotelId, status])
  @@index([hotelId, arrival])
  @@index([hotelId, mewsId])
}

model Conversation {
  id             String    @id
  guestId        String
  stage          String
  primaryChannel String
  aiStatus       String
  sentiment      String
  subject        String
  summary        String    @db.Text
  suggestedReply String    @db.Text
  knowledgeUsed  String    @default("[]")
  upsellIdeas    String    @default("[]")
  taskIds        String    @default("[]")
  escalation     String?   @db.Text
  unread         Int       @default(0)
  lastAt         String
  aiHandledCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  guest          Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([guestId], map: "Conversation_guestId_fkey")
}

model Message {
  id             String       @id
  conversationId String
  author         String
  channel        String
  body           String       @db.Text
  at             String
  staffName      String?
  knowledge      String       @default("[]")
  buttons        String       @default("[]")
  confidence     Float?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "Message_conversationId_fkey")
}

model Task {
  id             String      @id
  hotelId        String?     @default("hotel-mercier")
  title          String
  detail         String?     @db.Text
  room           String?
  guest          String?
  department     String
  priority       String      @default("Normal")
  createdAt      String
  due            String?
  assignee       String?
  status         String      @default("Pending")
  source         String      @default("AI Detection")
  conversationId String?
  trail          TaskTrail[]

  @@index([hotelId, status])
  @@index([hotelId, createdAt])
}

model TaskTrail {
  id     Int     @id @default(autoincrement())
  taskId String
  at     String
  text   String
  via    String?
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "TaskTrail_taskId_fkey")
}

model Issue {
  id           String        @id
  hotelId      String?       @default("hotel-mercier")
  room         String
  title        String
  detail       String?       @db.Text
  priority     String        @default("Normal")
  reportedBy   String
  via          String        @default("Dashboard")
  createdAt    String
  assignee     String?
  status       String        @default("Reported")
  outOfService Boolean       @default(false)
  updates      IssueUpdate[]

  @@index([hotelId, status])
  @@index([hotelId, createdAt])
}

model IssueUpdate {
  id      Int     @id @default(autoincrement())
  issueId String
  at      String
  text    String
  via     String?
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId], map: "IssueUpdate_issueId_fkey")
}

model Upsell {
  id      String  @id
  hotelId String? @default("hotel-mercier")
  guest   String
  room    String?
  offer   String
  value   Float
  channel String
  status  String
  date    String

  @@index([hotelId, status])
  @@index([hotelId, date])
}

model KnowledgeDoc {
  id              String           @id @default(uuid())
  hotelId         String?          @default("hotel-mercier")
  name            String
  category        String
  format          String
  size            String           @default("0 KB")
  updated         String           @default("Just now")
  status          String           @default("uploading")
  aiReady         Boolean          @default(true)
  usedToday       Int              @default(0)
  fileName        String?
  mimeType        String?
  fileSize        Int?
  storagePath     String?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  knowledgeChunks KnowledgeChunk[]

  @@index([hotelId, category])
}

model KnowledgeChunk {
  id             String       @id @default(uuid())
  knowledgeDocId String       @map("docId")
  hotelId        String?      @default("hotel-mercier")
  chunkIndex     Int
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  knowledgeDoc   KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@index([knowledgeDocId])
  @@index([hotelId])
}

model AiRule {
  id    Int    @id @default(autoincrement())
  topic String
  mode  String
  note  String @db.Text
}

model ActivityItem {
  id      String  @id
  hotelId String? @default("hotel-mercier")
  at      String
  kind    String
  text    String
  meta    String?

  @@index([hotelId, at])
}

model WaThread {
  id         String      @id
  contact    String
  role       String
  phone      String
  department String
  messages   WaMessage[]
}

model WaMessage {
  id       String   @id
  threadId String
  from     String
  body     String   @db.Text
  at       String
  buttons  String   @default("[]")
  chosen   String?
  thread   WaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId], map: "WaMessage_threadId_fkey")
}

model PmsIntegration {
  id                   String    @id @default(uuid())
  hotelId              String    @unique @default("hotel-mercier")
  provider             String    @default("mews")
  propertyId           String
  accessTokenEncrypted String?   @db.Text
  status               String    @default("connected")
  lastSyncAt           DateTime?
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model EmailIntegration {
  id          String   @id @default(uuid())
  hotelId     String   @unique
  email       String
  provider    String   @default("credentials")
  imapHost    String?
  imapPort    Int?
  smtpHost    String?
  smtpPort    Int?
  status      String   @default("connected")
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WhatsAppIntegration {
  id          String   @id @default(uuid())
  hotelId     String
  targetType  String
  phoneNumber String
  wabaId      String?
  status      String   @default("connected")
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, targetType])
}

model AiConfig {
  id            String   @id @default(uuid())
  hotelId       String   @unique
  tone          String   @default("warm")
  autonomyLevel String   @default("Autonomous")
  autoReply     Boolean  @default(true)
  rulesJson     String?  @db.Text
  updatedAt     DateTime @updatedAt
}

model OnboardingState {
  id             String   @id @default(uuid())
  hotelId        String   @unique
  pmsDone        Boolean  @default(false)
  emailDone      Boolean  @default(false)
  guestWaDone    Boolean  @default(false)
  internalWaDone Boolean  @default(false)
  kbDone         Boolean  @default(false)
  usersDone      Boolean  @default(false)
  aiDone         Boolean  @default(false)
  currentStep    Int      @default(1)
  updatedAt      DateTime @updatedAt
}
