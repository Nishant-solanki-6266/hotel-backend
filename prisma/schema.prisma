model Conversation {
  id             String    @id
  guestId        String
  stage          String
  primaryChannel String
  aiStatus       String
  sentiment      String
  subject        String
  summary        String    @db.Text
  suggestedReply String    @db.Text
  knowledgeUsed  String    @default("[]")
  upsellIdeas    String    @default("[]")
  taskIds        String    @default("[]")
  escalation     String?   @db.Text
  unread         Int       @default(0)
  lastAt         String
  aiHandledCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  guest          Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([guestId], map: "Conversation_guestId_fkey")
}

model Message {
  id             String       @id
  conversationId String
  author         String
  channel        String
  body           String       @db.Text
  at             String
  staffName      String?
  knowledge      String       @default("[]")
  buttons        String       @default("[]")
  confidence     Float?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "Message_conversationId_fkey")
}

